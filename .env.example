# Base URL of the IHPAU HR Cloud backend API (Django REST Framework, /api/v1/).
# Never commit a real .env file — only this example is version controlled.
VITE_API_BASE_URL=https://api.ihpau-hr.example.org/api/v1

# When true, the app boots using the in-memory mock data/service layer
# (src/data, src/services) instead of calling VITE_API_BASE_URL.
VITE_USE_MOCK_DATA=true
